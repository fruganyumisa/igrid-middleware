{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deviceId": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "protocol": {
      "type": "string",
      "enum": ["modbus", "dnp3", "mqtt"]
    }
  },
  "required": ["timestamp", "deviceId", "value", "protocol"]
}